+VERIFY_KINDS = {"none": 0, "py_compile": 1, "pytest": 2}
+ENVELOPE_FIELDS = {"version", "allowed_tools", "required_verify", "max_budget_usd", "max_model_calls",
+                   "max_replans", "runtime_digest", "replan_failures"}
