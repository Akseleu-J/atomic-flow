# NOTE: atomic_flow does not read .env files itself. Export these in your shell / process manager.
# Kaggle Model Proxy credentials are short-lived: run `atomic kaggle auth` (creates ~/.atomic_flow/kaggle.env, 0600).

# Server key for clients calling atomic_flow's HTTP API (>=16 chars; placeholders are refused at startup):
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ATOMIC_FLOW_SERVER_API_KEY=
ATOMIC_FLOW_PROJECT_ROOT=/path/to/your/project
# Optional: max simultaneous model-backed requests (default 4)
# ATOMIC_FLOW_MAX_CONCURRENCY=4
# Optional provider keys (referenced from config via api_key_env):
# ANTHROPIC_API_KEY=
# ATOMIC_FLOW_API_KEY=
