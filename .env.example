# Kaggle Model Proxy credentials are short-lived. Run `atomic kaggle auth` to create
# a private file at ~/.atomic_flow/kaggle.env; never paste the key into this file.

# Optional server-side key for clients calling atomic_flow's HTTP API.
# This is a separate key from Kaggle/provider inference credentials.
ATOMIC_FLOW_SERVER_API_KEY=replace-with-a-long-random-value
ATOMIC_FLOW_PROJECT_ROOT=C:/path/to/your/project
